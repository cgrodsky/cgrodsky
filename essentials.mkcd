  "source": "{\"essentials.ts\": \"/**\\n * Essentials \\u2014 a bundle of handy Minecraft command blocks.\\n *\\n * Features so far:\\n *   - sudo     : force a player to run a command\\n *   - fakechat : make chat look like a player said something\\n *\\n * (Title blocks coming later.)\\n */\\n//% color=\\\"#5C2D91\\\" weight=100 icon=\\\"\\uf120\\\" block=\\\"Essentials\\\"\\nnamespace essentials {\\n    /**\\n     * Force a player to actually RUN a command, as if they did it.\\n     * target is a selector: @a all, @r random, @p nearest, @s you,\\n     * or @a[name=\\\"Bob\\\"] for one specific player.\\n     * Leave the leading slash OFF the command.\\n     */\\n    //% block=\\\"sudo %target run command %command\\\"\\n    //% target.shadow=text command.shadow=text\\n    //% weight=100\\n    export function sudo(target: string, command: string): void {\\n        player.execute(`execute as ${target} at @s run ${command}`)\\n    }\\n\\n    /**\\n     * Make a chat line LOOK like a player said it (no command is run as them).\\n     * target is a selector (use @r or @p so one name shows).\\n     */\\n    //% block=\\\"fakechat %target says %message\\\"\\n    //% target.shadow=text message.shadow=text\\n    //% weight=90\\n    export function fakeChat(target: string, message: string): void {\\n        player.execute(`tellraw @a {\\\"rawtext\\\":[{\\\"text\\\":\\\"<\\\"},{\\\"selector\\\":\\\"${target}\\\"},{\\\"text\\\":\\\"> ${message}\\\"}]}`)\\n    }\\n}\\n\", \"README.md\": \"# Essentials\\n\\nA bundle of handy Minecraft command blocks. Adds an **Essentials** category.\\n\\n## Blocks (so far)\\n- **sudo `target` run command `cmd`** \\u2014 forces the target player to actually run the command (`execute as`).\\n- **fakechat `target` says `msg`** \\u2014 makes chat look like the target said the message.\\n\\n`target` is a selector: `@a` all, `@r` random, `@p` nearest, `@s` you, or `@a[name=\\\"Bob\\\"]`.\\n\\n## Coming next\\n- **Title** blocks (on-screen title / subtitle / actionbar text).\\n\\n## Install as an extension\\nIn MakeCode: **Extensions \\u2192 paste this repo's URL**. Or open the project and copy the blocks.\\n\", \"pxt.json\": \"{\\n    \\\"name\\\": \\\"essentials\\\",\\n    \\\"description\\\": \\\"Handy Minecraft command blocks: sudo, fakechat (title blocks coming soon).\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"minecraft\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"essentials.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"public\\\": true,\\n    \\\"preferredEditor\\\": \\\"tsprj\\\"\\n}\"}"
}