    "editor": "tsprj",
    "name": "commands"
  },
  "source": "{\"custom.ts\": \"/**\\n * Commands \\u2014 helper blocks for running Minecraft slash commands,\\n * speaking as another player, and \\\"sudo\\\" (forcing a player to act).\\n */\\n//% color=\\\"#AA00AA\\\" weight=100 icon=\\\"\\uf120\\\" block=\\\"Commands\\\"\\nnamespace commands {\\n    /**\\n     * Run any slash command (leave off the leading slash).\\n     */\\n    //% block=\\\"run command %command\\\"\\n    //% command.shadow=text\\n    export function run(command: string): void {\\n        player.execute(command)\\n    }\\n\\n    /**\\n     * Show a chat message as if another player said it.\\n     * Looks like:  <name> message\\n     */\\n    //% block=\\\"say %message|as player %name\\\"\\n    //% message.shadow=text name.shadow=text\\n    export function sayAs(message: string, name: string): void {\\n        player.execute(`tellraw @a {\\\"rawtext\\\":[{\\\"text\\\":\\\"<${name}> ${message}\\\"}]}`)\\n    }\\n\\n    /**\\n     * SUDO \\u2014 force the named player to actually run a command,\\n     * as if they did it themselves (leave off the leading slash).\\n     */\\n    //% block=\\\"sudo player %target|run command %command\\\"\\n    //% target.shadow=text command.shadow=text\\n    export function sudo(target: string, command: string): void {\\n        player.execute(`execute as @a[name=\\\"${target}\\\"] at @s run ${command}`)\\n    }\\n}\\n\", \"README.md\": \"# Commands extension\\n\\nAdds a **Commands** category with three blocks:\\n\\n- **run command** \\u2014 run any slash command (no leading `/`).\\n- **say _msg_ as player _name_** \\u2014 chat shows `<name> msg`, looks like that player said it.\\n- **sudo player _name_ run command _cmd_** \\u2014 forces that player to actually run the command.\\n\\n## Use as an extension\\nPush this to a GitHub repo, then in MakeCode: **Extensions \\u2192 paste the repo URL**.\\nOr just open this project and copy the blocks into your own.\\n\", \"pxt.json\": \"{\\n    \\\"name\\\": \\\"commands\\\",\\n    \\\"description\\\": \\\"Blocks for running commands, speaking as another player, and sudo.\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"minecraft\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"custom.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"public\\\": true,\\n    \\\"preferredEditor\\\": \\\"tsprj\\\"\\n}\"}"
}